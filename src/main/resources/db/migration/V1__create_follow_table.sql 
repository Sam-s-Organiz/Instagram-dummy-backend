CREATE TABLE follow (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    source_user_id BIGINT NOT NULL,
    target_user_id BIGINT NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_source_user FOREIGN KEY (source_user_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT fk_target_user FOREIGN KEY (target_user_id) REFERENCES users(id) ON DELETE CASCADE,

    CONSTRAINT ux_follow_pair UNIQUE (source_user_id, target_user_id)
);

-- Indexes for performance
CREATE INDEX idx_source_user ON follow(source_user_id);
CREATE INDEX idx_target_user ON follow(target_user_id);
